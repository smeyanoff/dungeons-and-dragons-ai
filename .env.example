# Переменные окружения для локальной разработки и docker-compose
# (build/docker-compose.yml, build/docker-compose.prod.yml).
# Скопируйте в .env: cp .env.example .env

# --- Telegram ---
TELEGRAM_BOT_TOKEN=test_token_placeholder

# --- PostgreSQL ---
# Используются docker-compose напрямую (сервис postgres) и для сборки DATABASE_URL
# внутри контейнера bot (host там всегда "postgres", не зависит от POSTGRES_PORT ниже).
POSTGRES_USER=dnd_user
POSTGRES_PASSWORD=dnd_password
POSTGRES_DB=dnd
POSTGRES_PORT=5432
# DATABASE_URL — только для локального запуска без Docker (go run ./cmd/bot).
# Значения user/password/db должны совпадать с POSTGRES_* выше.
DATABASE_URL=postgres://dnd_user:dnd_password@localhost:5432/dnd?sslmode=disable

# --- GigaChat ---
GIGACHAT_CLIENT_ID=test_client_id
GIGACHAT_CLIENT_SECRET=test_client_secret
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Доступные модели: GigaChat, GigaChat-Plus, GigaChat-Pro, GigaChat-Max,
# GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max (см. pkg/gigachat/models.go)
GIGACHAT_MODEL=GigaChat
# Модель для "проверочных" вызовов LLM (dm_analyzer: бой/квесты/предметы, pre-check
# проверок навыков) — структурная классификация/JSON, не творческая генерация текста,
# поэтому можно и стоит использовать модель дешевле, чем GIGACHAT_MODEL у самого DM.
GIGACHAT_ANALYZER_MODEL=GigaChat-2
# Доступные модели эмбеддингов: Embeddings, EmbeddingsGigaR (см. pkg/gigachat/models.go)
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
GIGACHAT_SKIP_TLS_VERIFY=false

# --- Qdrant ---
# QDRANT_HOST оставлен незаданным намеренно: docker-compose сам подставляет "qdrant"
# (сетевое имя сервиса) для контейнера bot, а локальный go run по умолчанию использует
# "localhost" (см. cmd/bot/main.go). Если раскомментируете для локального запуска —
# не переносите это значение при запуске через `docker compose --profile bot up`.
# QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6335

# --- Приложение ---
LOG_LEVEL=info
MONITORING_PORT=8081
ENABLE_PLAYBOOK_GENERATION=true
# Часовой пояс контейнера bot в production (build/docker-compose.prod.yml)
TZ=Europe/Moscow

# --- Security scans (make security-scan / gosec / trivy / semgrep / trufflehog / snyk) ---
# Нужен только для `make snyk` (build/docker-compose.security.yml, профиль with-snyk-token)
SNYK_TOKEN=
