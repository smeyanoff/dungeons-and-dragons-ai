# ============================================================================
# Dungeons & Dragons AI - Configuration
# ============================================================================
# Скопируйте этот файл в .env и заполните необходимые значения
# cp .env.example .env

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
# Токен бота, полученный от @BotFather
# Обязательно для работы бота
# Получить можно здесь: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# Имя пользователя для PostgreSQL
POSTGRES_USER=dnd_user

# Пароль для PostgreSQL
# ОБЯЗАТЕЛЬНО: Измените на надежный пароль в production!
POSTGRES_PASSWORD=change_me_strong_password

# Имя базы данных
POSTGRES_DB=dnd

# Порт PostgreSQL (опционально, по умолчанию 5432)
# Используется для доступа к БД с хоста
POSTGRES_PORT=5432

# URL подключения к PostgreSQL (автоматически формируется из переменных выше)
# Формат: postgres://username:password@host:port/database?sslmode=disable
# Можно переопределить для кастомной конфигурации
# Для Docker Compose:
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# Для локальной разработки:
# DATABASE_URL=postgres://user:password@localhost:5432/dnd?sslmode=disable

# ============================================================================
# GigaChat API Configuration
# ============================================================================
# Client ID для GigaChat API
# Обязательно: Получите в личном кабинете Sberbank AI
# https://developers.sber.ru/
GIGACHAT_CLIENT_ID=your_gigachat_client_id

# Client Secret для GigaChat API
# Обязательно: Получите в личном кабинете Sberbank AI
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret

# Модель GigaChat для генерации ответов
# Доступные значения: GigaChat, GigaChat-Pro, GigaChat-Max и др.
# По умолчанию: GigaChat
GIGACHAT_MODEL=GigaChat

# URL для аутентификации GigaChat API
# Обычно не требуется менять
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443

# URL для запросов к GigaChat API
# Обычно не требуется менять
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1

# Scope для GigaChat API
# GIGACHAT_API_PERS - для персонального использования (по умолчанию)
# GIGACHAT_API_CORP - для корпоративного использования
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель для эмбеддингов (RAG система)
# Доступные значения:
#   Embeddings - базовая модель (по умолчанию)
#   EmbeddingsGigaR - продвинутая модель
# Обычно не требуется менять
GIGACHAT_EMBEDDINGS_MODEL=Embeddings

# Валидация credentials при старте приложения
# true - проверять токен при запуске (может замедлить старт)
# false - не проверять (по умолчанию)
GIGACHAT_VALIDATE_ON_START=false

# ============================================================================
# Qdrant Vector Store Configuration
# ============================================================================
# Хост Qdrant сервера
# В Docker Compose: qdrant
# Локально: localhost
QDRANT_HOST=qdrant

# Порт Qdrant HTTP API
# По умолчанию: 6334 (внутри контейнера используется 6333)
# Используется для доступа к Qdrant с хоста
QDRANT_PORT=6334

# Порт Qdrant gRPC API (опционально, для docker-compose)
# По умолчанию: 6335
# Используется для доступа к Qdrant gRPC API с хоста
QDRANT_GRPC_PORT=6335

# ============================================================================
# Logging Configuration
# ============================================================================
# Уровень логирования
# Доступные значения: debug, info, warn, error
#   debug - детальная информация для отладки (много логов, не для production)
#   info  - общая информация о работе приложения (рекомендуется для production)
#   warn  - только предупреждения и ошибки
#   error - только ошибки
# По умолчанию: info
LOG_LEVEL=info

# Режим разработки для логгера
# true  - включает более детальное форматирование логов (developer-friendly)
#        - удобно для чтения в терминале при разработке
# false - production форматирование (структурированные JSON логи)
#        - рекомендуется для production и Docker
# По умолчанию: false
LOG_DEVELOPMENT=false

# ============================================================================
# Application Configuration
# ============================================================================
# Часовой пояс для приложения
# По умолчанию: Europe/Moscow
# Примеры: Europe/Moscow, UTC, America/New_York
TZ=Europe/Moscow

# ============================================================================
# Version Information (для сборки через Make)
# ============================================================================
# Версия приложения (автоматически определяется при сборке через Make)
# VERSION=dev

# Git commit hash (автоматически определяется при сборке через Make)
# COMMIT=unknown

# Время сборки (автоматически определяется при сборке через Make)
# BUILD_TIME=unknown
